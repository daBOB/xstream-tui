# Mullvad WireGuard settings for the gluetun kill-switch container.
# Copy to docker/mullvad.env, or generate it from a Mullvad config file:
#   scripts/mullvad-wg-to-env.sh ~/Downloads/mullvad-de-ber-wg-001.conf
#
# docker/mullvad.env is gitignored. Never commit the private key.

# [Interface] PrivateKey from the Mullvad .conf
WIREGUARD_PRIVATE_KEY=

# [Interface] Address from the Mullvad .conf (IPv4[,IPv6], comma separated)
WIREGUARD_ADDRESSES=

# Server selection - set ONE of these (gluetun matches against its Mullvad list).
# Hostname is the exact server, e.g. de-ber-wg-001
SERVER_HOSTNAMES=
# Or pick by city / country instead, e.g. SERVER_CITIES=Berlin
#SERVER_CITIES=
#SERVER_COUNTRIES=Germany

# Optional: let the container still reach your LAN (e.g. a NAS download target)
# while the kill switch blocks everything else outside the tunnel.
#FIREWALL_OUTBOUND_SUBNETS=192.168.1.0/24

# UDP port for the WireGuard handshake. Default 51820. If gluetun stays
# unhealthy with RX 0 on tun0, your network blocks 51820 - Mullvad also
# listens on 53.
#WIREGUARD_ENDPOINT_PORT=53
