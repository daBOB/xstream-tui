\/p\/w1280\/3sCIyApg6jDoiTRwrNHHETRLQ8F.jpg","https:\/\/image.tmdb.org\/t\/p\/w1280\/j4qTJxqRhpnV6dMcXss1Vnqn9fO.jpg"],"youtube_trailer":"_xAK3ueOJxE","tmdb":"1411","episode_run_time":"43","category_id":"209","category_ids":[209]},{"num":292,"name":"DE - The Equalizer (2021) (US)","series_id":22203,"cover":"https:\/\/image.tmdb.org\/t\/p\/w600_and_h900_bestv2\/wwLaTuwsKPXK3hhHVclpx8Ix04Q.jpg","plot":"Robyn McCall, eine r\u00e4tselhafte ehemalige CIA-Agentin mit geheimnisvollem Hintergrund, setzt ihre umfassenden F\u00e4higkeiten ein, um denen zu helfen, die sich sonst an niemanden wenden k\u00f6nnen.","cast":"Queen Latifah, Tory Kittles, Adam Goldberg, Liza Lapira, Laya DeLeon Hayes, Lorraine Toussaint","director":"Andrew W. Marlowe, Terri Edda Miller","genre":"Krimi \/ Drama","releaseDate":"2021-02-07","release_date":"2021-02-07","last_modified":"1739834248","rating":"8","rating_5based":"4","backdrop_path":["https:\/\/image.tmdb.org\/t\/p\/w1280\/4EbE6IGuTjIFSlB9nG14CuEi8NH.jpg","https:\/\/image.tmdb.org\/t\/p\/w1280\/z8CzVVAGHRRmgJQ6ZRjr8OuCmlj.jpg","https:\/\/image.tmdb.org\/t\/p\/w1280\/hKkj12UD1PVH3pZ8ndubjs7ljBF.jpg","https:\/\/image.tmdb.org\/t\/p\/w1280\/jk3H9csHsp7m5pEETGg3pg4WuQo.jpg","https:\/\/image.tmdb.org\/t\/p\/w1280\/gbdscULQrSAcSyFrF9l6fPzKVbI.jpg"],"youtube_trailer":"GxhdBM86KnE","tmdb":"95205","episode_run_time":"43","category_id":"209","category_ids":[209]},{"num":293,"name":"DE - Snowfall (US)","series_id":7791,"cover":"https:\/\/image.tmdb.org\/t\/p\/w154\/ox67NV3aOCSFHialy9MCtHtCi2l.jpg","plot":"In den fr\u00fchen 1980er Jahren \u00fcberschwemmt eine regelrechte Kokain-Epidemie die Entertainment-Metropole Los Angeles. Dies hinterl\u00e4sst auch bei den Einwohnern seine Spuren, die sich auf einem von Gewalt gezeichneten Kollisionskurs befinden: Franklin Saint, ein junger Unternehmer der Stra\u00dfe, der nach Macht d\u00fcrstet; der mexikanische Wrestler Gustavo Zapata, der zudem in einen Machtkampf in einer kriminellen Familie verstrickt ist; der CIA-Agent Teddy McDonald, der versucht vor einer d\u00fcsteren Vergangenheit zu fliehen und Luica Villanueva, die selbsts\u00fcchtige Tochter eines mexikanischen Drogenbarons.","cast":"","director":"John Singleton, Eric Amadio, Dave Andron","genre":"Krimi, Drama","releaseDate":"2017-07-05","release_date":"2017-07-05","last_modified":"1721564825","rating":"8","rating_5based":"4","backdrop_path":[],"youtube_trailer":"4r_xJO_s-mE","tmdb":"71694","episode_run_time":"42","category_id":"209","category_ids":[209]},{"num":294,"name":"DE - Those About to Die (2024) (US)","series_id":22191,"cover":"https:\/\/image.tmdb.org\/t\/p\/w600_and_h900_bestv2\/gvz0m4MJ8sAj6yMcQdwN07bNjRY.jpg","plot":"Rom, 79 n. Chr. Das Volk ist gelangweilt, unruhig und wird immer gewaltbereiter. Nur kostenlose Lebensmittel und spektakul\u00e4re Unterhaltung h\u00e4lt es noch in Schach. Das Verlangen nach blutr\u00fcnstiger Unterhaltung w\u00e4chst, also muss eine Arena f\u00fcr Gladiatorenk\u00e4mpfe errichtet werden - das Kolosseum. Im Untergrund arbeiten und leben tausende von Menschen. Menschen, die f\u00fcr diese Spiele sterben werden.","cast":"Anthony Hopkins, Tom Hughes, Sara Martins, Jojo Macari, Gabriella Pession, Dimitri Leonidas, Moe Hashim, Iwan Rheon","director":"","genre":"Drama","releaseDate":"2024-07-18","release_date":"2024-07-18","last_modified":"1721509195","rating":"8","rating_5based":"4","backdrop_path":["https:\/\/image.tmdb.org\/t\/p\/w1280\/vX71TGviqLsOtDNJ9q1QR4m14kH.jpg","https:\/\/image.tmdb.org\/t\/p\/w1280\/cyNollSgbSy5yK1cCasW5K2D62u.jpg","https:\/\/image.tmdb.org\/t\/p\/w1280\/tIoaQ6x64nnv9VyLsPKyY7Jj8Ou.jpg","https:\/\/image.tmdb.org\/t\/p\/w1280\/3m9t52rcLdQuDNEnyhtpn9y9CGp.jpg","https:\/\/image.tmdb.org\/t\/p\/w1280\/g5QI3a58QMFZAjyRyLmbOtUEUcg.jpg"],"youtube_trailer":"YdHjbI8w9mI","tmdb":"218589","episode_run_time":"0","category_id":"209","category_ids":[209]},{"num":295,"name":"DE - American Gods (US)","series_id":5209,"cover":"https:\/\/image.tmdb.org\/t\/p\/w154\/3KCAZaKHmoMIN9dHutqaMtubQqD.jpg","plot":"Ein Sturm zieht auf, als Shadow Moon aus dem Gef\u00e4ngnis kommt und auf den geheimnisvollen Mr. Wednesday trifft. Freigelassen wegen des Todes seiner Frau, nimmt Shadow eine Stelle als Wednesdays Bodyguard an. Dort findet er sich in einer verborgenen Welt wieder, in der Magie ganz real ist und in der die alten G\u00f6tter nichts mehr als ihre Unbedeutsamkeit und die aufsteigenden neuen G\u00f6tter f\u00fcrchten.","cast":"","director":"Michael Green, Bryan Fuller","genre":"Drama, Mystery, Sci-Fi & Fantasy","releaseDate":"2017-04-30","release_date":"2017-04-30","last_modified":"1721509156","rating":"7","rating_5based":"3.5","backdrop_path":[],"youtube_trailer":"","tmdb":"46639","episode_run_time":"60","category_id":"209","category_ids":[209]},{"num":296,"name":"DE - Citadel (2023) (US)","series_id":22178,"cover":"https:\/\/image.tmdb.org\/t\/p\/w600_and_h900_bestv2\/AcrDB32TqpAGwvQFbICALGxSzn3.jpg","plot":"Der unabh\u00e4ngige internationale Geheimdienst Citadel wurde von dem Syndikat Manticore zerst\u00f6rt. Die Elite-Spione Mason Kane und Nadia Sinh \u00fcberlebten knapp, doch ihre Erinnerungen wurden gel\u00f6scht. Acht Jahre sp\u00e4ter bittet Masons fr\u00fcherer Kollege Bernard Orlick ihn um Hilfe, um Manticore an der Errichtung einer neuen Weltordnung zu hindern.","cast":"Richard Madden, \u092a\u094d\u0930\u093f\u092f\u0902\u0915\u093e \u091a\u094b\u092a\u0921\u093c\u093e \u091c\u094b\u0928\u0938, Ashleigh Cummings, Roland M\u00f8ller, Osy Ikhile, Caoilinn Springall, Lesley Manville, Stanley Tucci","director":"Josh Appelbaum, Bryan Oh, David Weil","genre":"Drama \/ Krimi \/ Action & Adventure","releaseDate":"2023-04-27","release_date":"2023-04-27","last_modified":"1721501212","rating":"7","rating_5based":"3.5","backdrop_path":["https:\/\/image.tmdb.org\/t\/p\/w1280\/3cgRI0hOq3dYyezSYrsfdmqxtMw.jpg","https:\/\/image.tmdb.org\/t\/p\/w1280\/31tk8CYbdWneyVD7Xmc6WrNULai.jpg","https:\/\/image.tmdb.org\/t\/p\/w1280\/3gcUTqhS6F5bltcSfD1aG6Ax8vV.jpg","https:\/\/image.tmdb.org\/t\/p\/w1280\/oK6LwbANMx3t2S1hTIMM95gGyK2.jpg","https:\/\/image.tmdb.org\/t\/p\/w1280\/9lvf0IMklSE9A62MzdDGwViKFNm.jpg"],"youtube_trailer":"PrGAWWyBtus","tmdb":"114922","episode_run_time":"0","category_id":"209","category_ids":[209]},{"num":297,"name":"DE - Dead to Me (US)","series_id":1866,"cover":"https:\/\/image.tmdb.org\/t\/p\/w154\/dU4K5KGQVqSae8IMd55XAExmxoE.jpg","plot":"Eine unbeherrschte Witwe auf der Suche nach der Person, die ihren Mann \u00fcber den Haufen gefahren hat, freundet sich mit einer Optimistin an. Doch der Schein tr\u00fcgt.","cast":"","director":"Liz Feldman","genre":"Drama, Mystery, Krimi","releaseDate":"2019-05-03","release_date":"2019-05-03","last_modified":"1721491665","rating":"7","rating_5based":"3.5","backdrop_path":[],"youtube_trailer":"","tmdb":"81357","episode_run_time":"30","category_id":"209","category_ids":[209]},{"num":298,"name":"DE - Flashpoint: Das Spezialkommando (2008) (CA)","series_id":22122,"cover":"https:\/\/image.tmdb.org\/t\/p\/w600_and_h900_bestv2\/3Bp3vJrPxnrN8iRDaclsVUPwgWa.jpg","plot":"Die Serie handelt von der Strategic Response Unit (SRU), einer fiktiven taktischen Spezialeinheit der Polizei in der kanadischen Gro\u00dfstadt Toronto, \u00e4hnlich der real existierenden Emergency Task Force des Toronto Police Service.\r\n\r\nDie SRU ist damit beauftragt, Extremsituationen zu l\u00f6sen, f\u00fcr die die regul\u00e4ren Polizeikr\u00e4fte nicht entsprechend ausgebildet und ausgestattet sind: Geiselnahmen, Bombendrohungen und schwerbewaffnete Kriminelle geh\u00f6ren zu den \u00fcblichen Eins\u00e4tzen. Mit Sprengstoffen, Tasern, Maschinenpistolen, Sturm- und Scharfsch\u00fctzengewehren sowie akustischer und visueller \u00dcberwachungs- und Abh\u00f6rtechnik ist die Einheit bestens ausger\u00fcstet. Dennoch geh\u00f6ren Intuition, Urteilsverm\u00f6gen und Verhandlungsgeschick zu den ersten Mitteln bei der L\u00f6sung der Situation.","cast":"David Paetkau, Enrico Colantoni, Amy Jo Johnson, Hugh Dillon, Sergio Di Zio, Tattiawna Jones, Jack Knight, Olunik\u00e9 Adeliyi","director":"Stephanie Morgenstern, Mark Ellis","genre":"Drama \/ Action & Adventure","releaseDate":"2008-07-11","release_date":"2008-07-11","last_modified":"1721385018","rating":"7","rating_5based":"3.5","backdrop_path":["https:\/\/image.tmdb.org\/t\/p\/w1280\/6SlgW0xylNr2NikrZvMRd5tTwAo.jpg","https:\/\/image.tmdb.org\/t\/p\/w1280\/EMMOLIilPfL5R8Sxuz8SfaryOm.jpg","https:\/\/image.tmdb.org\/t\/p\/w1280\/2g7bmcbYeuwGUlim9APyHnzPe1Q.jpg","https:\/\/image.tmdb.org\/t\/p\/w1280\/a8IgIc4ESwtGa6kZ2mCHgsTSzLp.jpg","https:\/\/image.tmdb.org\/t\/p\/w1280\/9DdPd8ZDGCqYwJoodTVJvlJJNw1.jpg"],"youtube_trailer":"SHG182hgbXM","tmdb":"5829","episode_run_time":"44","category_id":"209","category_ids":[209]},{"num":299,"name":"DE - Boat Story (2023) (GB)","series_id":22121,"cover":"https:\/\/image.tmdb.org\/t\/p\/w600_and_h900_bestv2\/gaSiJDRPSgVAUHcP8GRz0Tsw0HS.jpg","plot":"Zwei hartgesottene Fremde sto\u00dfen auf einem schiffbr\u00fcchigen Boot auf eine Ladung Kokain. Sie geraten in Konflikt mit der Polizei und einem scharf gekleideten Gangster, der als \"The Tailor\" bekannt ist.","cast":"Paterson Joseph, Daisy Haggard, Tch\u00e9ky Karyo, Craig Fairbrass, Joanna Scanlan, Ethan Lawrence, Phil Daniels, Michele Austin","director":"Harry Williams, Jack Williams","genre":"Drama \/ Krimi","releaseDate":"2023-11-19","release_date":"2023-11-19","last_modified":"1721384881","rating":"7","rating_5based":"3.5","backdrop_path":["https:\/\/image.tmdb.org\/t\/p\/w1280\/pWY74gqzHiqOuGoqIExKPJKHOma.jpg","https:\/\/image.tmdb.org\/t\/p\/w1280\/pyS48f0l4JaNB3nVpyrOQ0NcYa2.jpg","https:\/\/image.tmdb.org\/t\/p\/w1280\/fSwBJPh6X3um3ocxyj7MqZcZZJm.jpg","https:\/\/image.tmdb.org\/t\/p\/w1280\/pYLTCXHULGp6k1tFufnf7prI6f7.jpg","https:\/\/image.tmdb.org\/t\/p\/w1280\/nrwB2oscTgcmOsnZMulvlWC0kam.jpg"],"youtube_trailer":"jSw4bPYY3QM","tmdb":"234377","episode_run_time":"0","category_id":"209","category_ids":